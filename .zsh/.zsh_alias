
alias ls='ls -hF --color=always'
alias ll='ls -lhF --color=always'
alias la='ls -alhF --color=always'
alias grep='grep --color=auto'

#alias vim='nvim'
alias tma='tmux attach'
alias tm='tmux'

if [ -f /mnt/c/Windows/explorer.exe ]; then
    alias xdg=/mnt/c/Windows/explorer.exe
fi
#C:\Program Files\Google\Chrome\Application
if [ -f /mnt/c/Program\ Files/Google/Chrome/Application/chrome.exe ]; then
    alias chrome='/mnt/c/Program\ Files/Google/Chrome/Application/chrome.exe'
fi

exit() {
    if [[ -n $TMUX ]]; then
        tmux detach
    else
        builtin exit "$@"
    fi
}

function gs() {
   git status
}

function gc() {
   git commit "$@"
}

function gl() {
   git log --pretty=format:"Commit:  %C(yellow)%H%Creset %C(auto)%d%Creset%nAuthor:  %C(green)%an%Creset%nDate:    %C(cyan)%ad%Creset%nMessage: %s%n" --date=format:"%Y-%m-%d %H:%M" --decorate=short --color=always
}

function gai() {
   git add -i
}

